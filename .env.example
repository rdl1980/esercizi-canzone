# Copia questo file in `.env` e compila i valori.

# Obbligatoria: chiave API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modello Claude con visione usato per scegliere parole e fotogrammi
CLAUDE_MODEL=claude-sonnet-5-5

# Chiave per firmare il cookie di sessione. Se vuota viene generata e salvata in data/.secret_key
SECRET_KEY=

# Metti a true solo se il sito è servito via HTTPS
COOKIE_SICURO=false

# Cartella dei dati (database SQLite, video, immagini, PDF). Predefinita: ./data
# DATA_DIR=./data

# Un fotogramma ogni N secondi (2-3 consigliato)
INTERVALLO_FOTOGRAMMI=2.5

# Durata massima accettata per un video, in secondi
DURATA_MAX_VIDEO=900

# Secondo tentativo di download con il client YouTube standard + componenti remoti (serve node o deno)
YTDLP_REMOTE_COMPONENTS=true

# Percorsi degli eseguibili, se non sono nel PATH
# FFMPEG_BIN=ffmpeg
# YTDLP_BIN=yt-dlp
